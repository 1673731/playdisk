{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tu-backend-real.com",
        "EXPO_PUBLIC_API_KEY": "PON_AQUI_TU_API_KEY_REAL"
      }
    },
    "production": {
      "autoIncrement": "versionCode",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tu-backend-real.com",
        "EXPO_PUBLIC_API_KEY": "PON_AQUI_TU_API_KEY_REAL"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
